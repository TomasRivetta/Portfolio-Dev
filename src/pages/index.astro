---
import Layout from "../layouts/Layout.astro";
import Image from 'astro/components/Image.astro'

import fotoPerfil from "../assets/imgs/fotoPerfil.webp";

import linkedlinIcon from "../assets/svg/linkedlin.svg";
import gitHubIcon from "../assets/svg/github.svg";
import fileIcon from "../assets/svg/file.svg";
import typescriptIcon from "../assets/svg/typescript.svg"
import tailwindIcon from "../assets/svg/tailwind.svg"
import javascriptIcon from "../assets/svg/javascript.svg"
import gitIcon from "../assets/svg/git.svg"
import mongoIcon from "../assets/svg/brand-mongodb.svg"
import msSqlServerIcon from "../assets/svg/brand-database.svg"
import nodeIcon from "../assets/svg/brand-nodejs.svg"
import htmlIcon from "../assets/svg/brand-html5.svg";
import cssIcon from "../assets/svg/brand-css3.svg";
import bootstrapIcon from "../assets/svg/brand-bootstrap.svg";
import astroIcon from "../assets/svg/brand-astro.svg";
import figmaIcon from "../assets/svg/brand-figma.svg";
import mailIcon from "../assets/svg/mail.svg"
import javaIcon from "../assets/svg/java.svg"
import angularIcon from "../assets/svg/angular.svg"



---
<Layout title="Portfolio Tomas Rivetta">
	<section class="mx-4 sm:mx-6 md:mx-8 lg:mx-10 mt-3 mb-3">
		<!-- GRID PRINCIPAL -->
		<div class="grid grid-cols-1 lg:grid-cols-6 gap-3 lg:gap-4">
			<div class="lg:col-span-3 bg-custom p-3 sm:p-4 rounded-2xl">
	
				<div class="flex flex-col md:flex-row items-center md:items-start gap-4">
	
					<div class="w-24 h-24 sm:w-32 sm:h-32 gb-gray-600 rounded-full overflow-hidden flex-shrink-0">
	
						<Image src={fotoPerfil} alt="Foto de perfil de Tomas Rivetta" class="w-full h-full object-cover"/>						
					</div>
					<div class="text-center md:text-left">
						<h1 class="text-xl sm:text-2xl font-bold text-cyan-50">Tomas Rivetta</h1>
						<p class="text-xs sm:text-sm text-zinc-50">
							Full Stack Developer | Apasionado por la Programación
						</p>
						<p class="text-xs sm:text-sm text-cyan-50 mt-2">
							Soy un <span class="font-bold">Full Stack Developer</span>
Me especializo en el desarrollo de aplicaciones web robustas y escalables, utilizando Angular para el frontend y Java con Spring Boot en el backend.
						</p>
						<div class="flex flex-wrap justify-center md:justify-start gap-2 mt-3 sm:mt-4">


							<a href="https://www.linkedin.com/in/tomasrivetta-fullstack/" target="_blank">
								<button class="bg-gray-700 hover:bg-gray-800 text-white font-bold py-1.5 px-3 rounded-full text-xs sm:text-sm">				
									<div class="flex items-center gap-1">
										<Image src={linkedlinIcon} alt="Logo de Linkedin" class="w-4 h-4">
										</Image>
										<span class="hidden sm:inline">Linkedlin</span>
									</div>		
								</button>
							</a>

							<a href="https://github.com/TomasRivetta" target="_blank">
								<button class="bg-gray-700 hover:bg-gray-800 text-white font-bold py-1.5 px-3 rounded-full text-xs sm:text-sm">
									<div class="flex items-center gap-1">
										<Image src={gitHubIcon} alt="Logo de GitHub" class="w-4 h-4">
										</Image>
										<span class="hidden sm:inline">GitHub</span>
									</div>
								</button>
							</a>

							<a href="../../public/TomasRivetta-Curriculum.pdf" target="_blank" rel="noopener noreferrer">
								<button class="bg-gray-700 hover:bg-gray-800 text-white font-bold py-1.5 px-3 rounded-full text-xs sm:text-sm">
									<div class="flex items-center gap-1">
										<Image src={fileIcon} alt="Logo de GitHub" class="w-4 h-4">
										</Image>
										<span class="hidden sm:inline">CV</span>
									</div>
								</button>
							</a>

							<a href="mailto:totorivetta@gmail.com" target="_blank">
								<button class="bg-gray-700 hover:bg-gray-800 text-white font-bold py-1.5 px-3 rounded-full text-xs sm:text-sm">
									<div class="flex items-center gap-1">
										<Image src={mailIcon} alt="Logo de mail" class="w-4 h-4">
										</Image>
										<span class="hidden sm:inline">Contactame</span>
									</div>
								</button>
							</a>
						

						</div>
					</div>
	
				</div>
			</div>

			<div class="lg:col-span-3 bg-custom p-3 sm:p-4 rounded-2xl">

				<h2 class="text-xl sm:text-2xl font-bold text-cyan-50 mb-3">Educación</h2>
				<div>
					<h3 class="text-base sm:text-lg font-semibold text-zinc-50">UTN Universidad Tecnológica Nacional</h3>
					<p class="text-xs sm:text-sm text-zinc-400">Ene. 2023 - Feb. 2026</p>
					<p class="text-xs sm:text-sm text-zinc-400">Técnico universitario en Programación</p>
					<p class="text-xs sm:text-sm text-cyan-50 mt-1">
						- Lógica de Programación<br>
						- Estructuras de datos<br>
						- Programación orientada a objetos
					</p>
				</div>

				<!-- <div class="mt-3">
	
					<h3 class="text-lg font-semibold text-zinc-50">Programa Codo A Codo</h3>
	
					<p class="text-sm text-zinc-400">
						Jun. 2023 - Nov. 2024
					</p>
					<p class="text-sm text-zinc-400">
						Full Stack Developer
					</p>
					<p class="text-cyan-50">
						- Desarrollo Web (HTML,CSS,JavaScript/Node.js).<br>
						- Desarrollo Web responsive.<br>
						- Accesibilidad web.
					</p>
	
				</div> -->

				<!-- <div class="mt-3">
	
					<h3 class="text-lg font-semibold text-zinc-50">Alura ONE(Oracle Next Education)</h3>
	
					<p class="text-sm text-zinc-400">
						Jul. 2022 - Ene. 2023
					</p>
					<p class="text-sm text-zinc-400">
						Full Stack Developer
					</p>
					<p class="text-cyan-50">
						- Especializado en el desarrollo web responsive.<br>
						- Accesibilidad web.
					</p>
	
				</div> -->
			</div>

			<!-- Habilidades -->
			<div class="lg:col-span-2 bg-custom p-3 sm:p-4 rounded-2xl">
				<h2 class="text-xl sm:text-2xl font-bold text-cyan-50 text-center mb-3">Habilidades</h2>
				
				<div class="space-y-3">
					<div>
						<h3 class="text-sm font-semibold text-cyan-400 mb-2">Técnicas</h3>
						<div class="flex flex-wrap gap-2">
							<span class="bg-gray-700 text-cyan-50 text-xs px-2 py-1 rounded-full">APIs RESTful</span>
							<span class="bg-gray-700 text-cyan-50 text-xs px-2 py-1 rounded-full">Git & GitHub</span>
							<span class="bg-gray-700 text-cyan-50 text-xs px-2 py-1 rounded-full">Metodologías Ágiles</span>
							<span class="bg-gray-700 text-cyan-50 text-xs px-2 py-1 rounded-full">Diseño Responsive</span>
							<span class="bg-gray-700 text-cyan-50 text-xs px-2 py-1 rounded-full">Testing</span>
						</div>
					</div>
					
					<div>
						<h3 class="text-sm font-semibold text-cyan-400 mb-2">Blandas</h3>
						<div class="flex flex-wrap gap-2">
							<span class="bg-gray-700 text-cyan-50 text-xs px-2 py-1 rounded-full">Trabajo en equipo</span>
							<span class="bg-gray-700 text-cyan-50 text-xs px-2 py-1 rounded-full">Comunicación efectiva</span>
							<span class="bg-gray-700 text-cyan-50 text-xs px-2 py-1 rounded-full">Resolución de problemas</span>
							<span class="bg-gray-700 text-cyan-50 text-xs px-2 py-1 rounded-full">Aprendizaje continuo</span>
							<span class="bg-gray-700 text-cyan-50 text-xs px-2 py-1 rounded-full">Adaptabilidad</span>
						</div>
					</div>
				</div>
			</div>

			<!-- Tecnologias -->
			<div class="lg:col-span-4 bg-custom p-3 sm:p-4 rounded-2xl">

				<h2 class="text-xl sm:text-2xl font-bold text-cyan-50 text-center mb-3">Tecnologías</h2>
				<div class="grid grid-cols-4 sm:grid-cols-5 md:grid-cols-7 lg:grid-cols-7 gap-3 sm:gap-4">

					<div class="flex justify-center flex-col items-center gap-1">
						<Image src={htmlIcon} alt="Icono de HTML" class="w-10 h-10 sm:w-12 sm:h-12"></Image>
						<p class="text-xs text-zinc-50 text-center">HTML</p>
					</div>

					<div class="flex justify-center flex-col items-center gap-1">
						<Image src={cssIcon} alt="Icono de CSS" class="w-10 h-10 sm:w-12 sm:h-12"></Image>
						<p class="text-xs text-zinc-50 text-center">CSS</p>
					</div>
					
					<div class="flex justify-center flex-col items-center gap-1">
						<Image src={bootstrapIcon} alt="Icono de Bootstrap" class="w-10 h-10 sm:w-12 sm:h-12"></Image>
						<p class="text-xs text-zinc-50 text-center">Bootstrap</p>
					</div>

					<div class="flex justify-center flex-col items-center gap-1">
						<Image src={tailwindIcon} alt="Icono de Tailwind" class="w-10 h-10 sm:w-12 sm:h-12"></Image>
						<p class="text-xs text-zinc-50 text-center">Tailwind</p>
					</div>

					<div class="flex justify-center flex-col items-center gap-1">
						<Image src={javascriptIcon} alt="Icono de JavaScript" class="w-10 h-10 sm:w-12 sm:h-12"></Image>
						<p class="text-xs text-zinc-50 text-center">JavaScript</p>
					</div>

					<div class="flex justify-center flex-col items-center gap-1">
						<Image src={typescriptIcon} alt="Icono de TypeScript" class="w-10 h-10 sm:w-12 sm:h-12"></Image>
						<p class="text-xs text-zinc-50 text-center">TypeScript</p>
					</div>

					<div class="flex justify-center flex-col items-center gap-1">
						<Image src={msSqlServerIcon} alt="Icono de Microsoft Sql Server" class="w-10 h-10 sm:w-12 sm:h-12"></Image>
						<p class="text-xs text-zinc-50 text-center">MS SQL</p>
					</div>

					<div class="flex justify-center flex-col items-center gap-1">
						<Image src={mongoIcon} alt="Icono de Mongo DB" class="w-10 h-10 sm:w-12 sm:h-12"></Image>
						<p class="text-xs text-zinc-50 text-center">MongoDB</p>
					</div>

					<div class="flex justify-center flex-col items-center gap-1">
						<Image src={nodeIcon} alt="Icono de Node JS" class="w-10 h-10 sm:w-12 sm:h-12"></Image>
						<p class="text-xs text-zinc-50 text-center">Node JS</p>
					</div>

					<div class="flex justify-center flex-col items-center gap-1">
						<Image src={angularIcon} alt="Icono de Angular" class="w-10 h-10 sm:w-12 sm:h-12"></Image>
						<p class="text-xs text-zinc-50 text-center">Angular</p>
					</div>

					<div class="flex justify-center flex-col items-center gap-1">
						<Image src={astroIcon} alt="Icono de Astro" class="w-10 h-10 sm:w-12 sm:h-12"></Image>
						<p class="text-xs text-zinc-50 text-center">Astro</p>
					</div>

					<div class="flex justify-center flex-col items-center gap-1">
						<Image src={javaIcon} alt="Icono de Java" class="w-10 h-10 sm:w-12 sm:h-12"></Image>
						<p class="text-xs text-zinc-50 text-center">Java</p>
					</div>

					<div class="flex justify-center flex-col items-center gap-1">
						<Image src={gitIcon} alt="Icono de Git" class="w-10 h-10 sm:w-12 sm:h-12"></Image>
						<p class="text-xs text-zinc-50 text-center">Git</p>
					</div>

					<div class="flex justify-center flex-col items-center gap-1">
						<Image src={figmaIcon} alt="Icono de Figma" class="w-10 h-10 sm:w-12 sm:h-12"></Image>
						<p class="text-xs text-zinc-50 text-center">Figma</p>
					</div>
				
				</div>

			</div>

			<!-- Proyectos -->
			<div class="lg:col-span-2 bg-custom p-3 sm:p-4 rounded-2xl flex flex-col items-center justify-center">
				<h2 class="text-xl sm:text-2xl font-bold text-cyan-50 mb-2 text-center">Proyectos</h2>
				<p class="text-xs sm:text-sm text-zinc-400 text-center mb-4">
					Descubre mis proyectos y aplicaciones.
				</p>
				
				<a href="/proyectos">
					<button class="bg-cyan-600 hover:bg-cyan-500 text-white font-bold py-2 px-4 rounded-full transition-all text-xs sm:text-sm group">
						<div class="flex items-center gap-2">
							<span>Ver proyectos</span>
							<svg 
								xmlns="http://www.w3.org/2000/svg" 
								class="w-4 h-4 transition-transform group-hover:translate-x-1" 
								fill="none" 
								viewBox="0 0 24 24" 
								stroke="currentColor"
							>
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
							</svg>
						</div>
					</button>
				</a>
	
			</div>


		</div>

	</section>

</Layout>
<style>
	.bg-custom{
		background-color: rgb(19, 19, 19);
		border: solid 1px #333;
	}
</style>