---
import gitHubIcon from "../assets/svg/github.svg";
import liveIcon from "../assets/svg/live.svg"

export interface Props{
    id: string;
    title: string;
    imageSrc: string;
    description: string;
    githubLink: string;
    liveLink: string;
}

const {id,title,imageSrc,description,githubLink,liveLink} = Astro.props;

---

			<div class="grid grid-cols-1 md:grid-cols-2 gap-5 sm:gap-8 lg:gap-10 mt-3 max-w-4xl">

				<div>
					<img src={imageSrc} alt={title} class="rounded-2xl w-full h-auto"/>
				</div>
				<div>
					<span class="text-xl sm:text-2xl text-cyan-50 font-bold">
						{title}
					</span>
					<p class="text-sm sm:text-base text-cyan-50 mt-3">
						{description}
					</p>
					<div class="flex flex-wrap gap-2 sm:gap-3 mt-3">
						<a href={githubLink} target="_blank" rel="noopener noreferrer">
							<button class="bg-gray-700 
							hover:bg-gray-800 
							text-white font-bold py-1.5 px-3 sm:py-2 sm:px-4 rounded-full text-sm sm:text-base">
								<div class="flex items-center gap-1">
									<img src={gitHubIcon.src} alt="Logo de GitHub" class="w-4 h-4 sm:w-5 sm:h-5"/>
									<span>
										Repositorio
									</span>
								</div>
							</button>
						</a>

						<!-- <a href={liveLink} target="_blank" rel="noopener noreferrer">
							<button class="bg-gray-700 
							hover:bg-gray-800 
							text-white font-bold py-1.5 px-3 sm:py-2 sm:px-4 rounded-full text-sm sm:text-base">
								<div class="flex items-center gap-1">
									<img src={liveIcon.src} alt="Logo de GitHub" class="w-4 h-4 sm:w-5 sm:h-5"/>
									<span>
										Live
									</span>
								</div>
							</button>
						</a> -->
					</div>
				</div>

			</div>